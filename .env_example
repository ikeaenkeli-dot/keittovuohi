# Copy this file to .env and fill in the values.

# Bot token from @BotFather (required)
TOKEN=123456789:AA...

# PostgreSQL connection (required). Not needed with docker compose, it sets its own.
DATABASE_URL=postgres://user:password@localhost:5432/blakkis
# Set to true for hosted databases that need SSL (Render, Neon, Supabase, Heroku...)
DATABASE_SSL=false

# Long random string used to encrypt nicknames (required).
# NEVER change it afterwards, or old nicknames can't be decrypted anymore.
SECRET=change-me-to-a-long-random-string

# polling = bot fetches messages itself (simplest, works anywhere)
# webhook = Telegram pushes messages to APP_URL (needs a public HTTPS address)
BOT_MODE=polling
#APP_URL=https://your-app.onrender.com
#PORT=3000

# Your own Telegram user id for admin commands and error reports (ask @userinfobot)
ADMIN_ID=

TZ=Europe/Helsinki
